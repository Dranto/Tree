// Présence enrichie Steam (jalon 12 D) : à déposer sur Steamworks › Communauté › Présence enrichie.
// Le jeu envoie « region » (id de la région, « graine » au départ, « finale » sous la graine) et steam_display = « #Explore ».
// Noms anglais : glossaire validé par Antoine (godot/locale/glossaire.md, 25/11).
"lang"
{
	"french"
	{
		"tokens"
		{
			"#Explore"	"{#Region_%region%}"
			"#Region_graine"	"Au pied de la graine"
			"#Region_ronce"	"Dans la région de Ronce"
			"#Region_spore"	"Dans la région de Spore"
			"#Region_vent"	"Dans la région de Vent"
			"#Region_seve"	"Dans la région de Sève"
			"#Region_aube"	"Dans la région d'Aube"
			"#Region_racine"	"Dans la région de Racine"
			"#Region_finale"	"Sous la graine, face à la Flétrissure"
		}
	}
	"english"
	{
		"tokens"
		{
			"#Explore"	"{#Region_%region%}"
