; Fichier de configuration du projet Godot 4.
config_version=5

[application]

config/name="Arborescence"
config/description="Action-RPG : un monde désolé reprend vie au rythme de ton arbre de compétences."
config/version="0.13.0"
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon/icon.png"
boot_splash/bg_color=Color(0.1647, 0.1294, 0.0941, 1)
boot_splash/image="res://assets/icon/splash.png"
boot_splash/fullsize=true
boot_splash/show_image=true

[autoload]

UserDirMigration="*res://scripts/user_dir_migration.gd"
SteamBridge="*res://scripts/steam_bridge.gd"
Game="*res://scripts/game.gd"
Cycles="*res://scripts/cycles.gd"
SaveGame="*res://scripts/save_game.gd"
Settings="*res://scripts/settings.gd"
Rumble="*res://scripts/rumble.gd"
Flow="*res://scripts/flow.gd"
UiAudit="*res://scripts/ui_audit.gd"
Sfx="*res://scripts/sfx.gd"
Music="*res://scripts/music.gd"
Objectives="*res://scripts/objectives.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.05, 0.05, 0.05, 1)

[internationalization]

locale/translations=PackedStringArray("res://locale/fr.po", "res://locale/en.po")
locale/fallback="fr"

[physics]

common/physics_ticks_per_second=60
common/physics_interpolation=true

[shader_globals]

cycle_tint_from={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
cycle_tint_to={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
cycle_tint_wave={
"type": "vec4",
"value": Vector4(0, 0, 0, 1)
}
cycle_tint_ash={
"type": "vec3",
"value": Vector3(0.5, 0.5, 0.5)
}
