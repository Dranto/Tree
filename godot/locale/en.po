msgid "Rosée"
msgstr "Dew"

#. data/attack.json › mods › rosee › text
msgid "Un ennemi tué par l'attaque te rend {p} % de ta vie maximale (au plus quatre fois par seconde)."
msgstr "An enemy killed by the attack restores {p}% of your maximum life (at most four times per second)."

#. data/attack.json › mods › saignement › name
msgid "Saignement"
msgstr "Bleed"

#. data/attack.json › mods › saignement › text
msgid "Chaque coup fait saigner ({p} % des dégâts par seconde)."
msgstr "Each hit causes bleeding ({p}% of damage per second)."

#. data/attack.json › mods › sangsue › name
msgid "Sangsue"
msgstr "Leech"

#. data/attack.json › mods › sangsue › text
msgid "Chaque coup de l'attaque te rend {p} % des dégâts infligés."
msgstr "Each hit of the attack gives you back {p}% of the damage dealt."

#. data/attack.json › mods › saut › name
msgid "Saut"
msgstr "Leap"

#. data/attack.json › mods › saut › text
msgid "L'attaque saute d'ennemi empoisonné en ennemi empoisonné : +{v} saut(s)."
msgstr "The attack leaps from poisoned enemy to poisoned enemy: +{v} leap(s)."

#. data/attack.json › mods › secousse › name
#. data/branches/racine.json › racine › clusters › massue › nodes › m5 › name
#. scripts/options_panel.gd:146
msgid "Secousse"
msgstr "Tremor"

#. data/attack.json › mods › secousse › text
msgid "Chaque coup secoue le sol au point d'impact (devant toi au corps à corps) : {p} % des dégâts aux ennemis autour."
msgstr "Each hit shakes the ground at the point of impact (in front of you in melee): {p}% of damage to nearby enemies."

#. data/attack.json › mods › taille › name
msgid "Taille"
msgstr "Size"

#. data/attack.json › mods › taille › text
msgid "Attaque plus grande : +{p} %."
msgstr "Larger attack: +{p}%."

#. data/attack.json › mods › trainee › name
msgid "Traînée d'épines"
msgstr "Thorn Trail"

#. data/attack.json › mods › trainee › text
msgid "L'attaque sème des épines au sol ({p} % des dégâts par seconde) : le long d'un projectile, au point d'impact sinon."
msgstr "The attack sows thorns on the ground ({p}% of damage per second): along a projectile's path, otherwise at the point of impact."

#. data/attack.json › mods › volee › name
#. data/skills.json › volee › short
msgid "Volée"
msgstr "Volley"

#. data/attack.json › mods › volee › text
msgid "Une attaque sur {n} part en couronne tout autour de toi."
msgstr "One attack in {n} fires in a ring all around you."

