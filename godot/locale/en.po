#. data/attack.json › forms › bourrasque › desc
msgid "Un souffle en cône devant toi, qui blesse, repousse et emporte les plumes des Planeurs."
msgstr "A cone of wind before you that wounds, knocks back and strips the Gliders of their feathers."

#. data/attack.json › forms › bourrasque › name
#. data/branches/vent.json › vent › clusters › course › nodes › r6 › name
#. data/branches/vent.json › vent › notable › names
msgid "Bourrasque"
msgstr "Gust"

#. data/attack.json › forms › dard › desc
msgid "Une volée rapide de fines aiguilles de moisissure qui perforent."
msgstr "A quick volley of fine, piercing mold needles."

#. data/attack.json › forms › dard › name
#. data/branches/spore.json › spore › clusters › graines › nodes › a2 › name
msgid "Dards fongiques"
msgstr "Fungal Darts"

#. data/attack.json › forms › echarde › desc
msgid "Une rafale courte d'échardes qui perforent."
msgstr "A short burst of piercing splinters."

#. data/attack.json › forms › echarde › name
#. data/branches/racine.json › racine › clusters › ecorce › nodes › e2 › name
#. data/branches/ronce.json › ronce › clusters › epines › nodes › e7 › name
msgid "Échardes"
msgstr "Splinters"

#. data/attack.json › forms › fouet › desc
msgid "Un coup de fouet en arc, au corps à corps, qui repousse."
msgstr "A sweeping melee lash that knocks back."

#. data/attack.json › forms › fouet › name
#. data/skills.json › fouet › short
msgid "Fouet"
msgstr "Whip"

#. data/attack.json › forms › graine › desc
msgid "Un éventail de graines de sève vers la cible."
msgstr "A fan of sap seeds toward the target."

#. data/attack.json › forms › graine › name
msgid "Graines"
msgstr "Seeds"

#. data/attack.json › forms › lame › desc
msgid "Des lames de vent qui fendent tout sur leur passage, puis reviennent à toi."
msgstr "Blades of wind that cleave through everything in their path, then return to you."

#. data/attack.json › forms › lame › name
#. data/branches/vent.json › vent › clusters › lames › name
#. data/branches/vent.json › vent › clusters › lames › nodes › l1 › name
msgid "Lames de vent"
msgstr "Wind Blades"

#. data/attack.json › forms › massue › desc
msgid "Un lourd coup de massue en arc devant toi : lent, mais il écrase et repousse tout ce qu'il touche."
msgstr "A heavy sweeping club blow before you: slow, but it crushes and knocks back all it touches."

#. data/attack.json › forms › massue › name
#. data/branches/racine.json › racine › clusters › massue › name
#. data/branches/racine.json › racine › clusters › massue › nodes › m1 › name
msgid "Massue de bois"
msgstr "Wooden Club"

#. data/attack.json › forms › perle › desc
msgid "De lourdes perles de sève qui éclaboussent à l'impact ; chaque perle qui touche te rend un peu de vie."
msgstr "Heavy pearls of sap that splash on impact; each pearl that hits gives you back a little life."

#. data/attack.json › forms › perle › name
#. data/branches/seve.json › seve › clusters › perles › name
#. data/branches/seve.json › seve › clusters › perles › nodes › p1 › name
msgid "Perles de sève"
msgstr "Sap Pearls"

#. data/attack.json › forms › rayon › desc
#. {0}, {1}… : nombres du texte d'origine, remis au format de la langue.
msgid "Un rayon de lumière qui part d'un coup jusqu'à sa portée et traverse tout ce qu'il touche ; il vise juste (+{0} % de chance de critique)."
msgstr "A ray of light that reaches its full range at once and passes through all it touches; it aims true (+{0}% critical chance)."

#. data/attack.json › forms › rayon › name
#. data/branches/aube.json › aube › clusters › rayon › name
#. data/branches/aube.json › aube › clusters › rayon › nodes › l1 › name
msgid "Rayon d'aube"
msgstr "Dawn Ray"

#. data/attack.json › forms › ronce_vive › desc
msgid "Des graines qui plantent une ronce piégeuse là où elles tombent."
msgstr "Seeds that plant a snaring bramble where they land."

#. data/attack.json › forms › ronce_vive › name
#. data/branches/ronce.json › ronce › clusters › sang › nodes › s8 › name
msgid "Ronces vives"
msgstr "Living Brambles"

#. data/attack.json › forms › spore_lobee › desc
msgid "Des spores lancées en cloche qui éclatent à l'arrivée et laissent un petit nuage de spores."
msgstr "Spores lobbed in an arc that burst on landing and leave a small spore cloud."

#. data/attack.json › forms › spore_lobee › name
#. data/branches/spore.json › spore › clusters › nuee › nodes › n6 › name
msgid "Spores lobées"
msgstr "Lobbed Spores"

#. data/attack.json › mods › aubier › name
#. data/branches/racine.json › racine › clusters › massue › nodes › m7 › name
msgid "Aubier"
msgstr "Sapwood"

#. data/attack.json › mods › aubier › text
#. {0}, {1}… : nombres du texte d'origine, remis au format de la langue.
msgid "Chaque coup de l'attaque te couvre d'écorce : {p} % des dégâts en bouclier (au plus {0} % de ta vie maximale)."
msgstr "Each hit of the attack covers you in bark: {p}% of damage as a shield (at most {0}% of your maximum life)."

#. data/attack.json › mods › bouffee › name
msgid "Bouffée"
msgstr "Puff"

#. data/attack.json › mods › bouffee › text
msgid "Un ennemi tué par l'attaque libère un petit nuage de spores ({p} % des dégâts par seconde)."
msgstr "An enemy killed by the attack releases a small spore cloud ({p}% of damage per second)."

#. data/attack.json › mods › eblouit › name
msgid "Éblouissement"
msgstr "Dazzle"

#. data/attack.json › mods › eblouit › text
#. {0}, {1}… : nombres du texte d'origine, remis au format de la langue.
msgid "{p} % de chances d'éblouir l'ennemi touché ({0} s) : les coups critiques le trouvent plus souvent."
msgstr "{p}% chance to dazzle the enemy hit ({0} s): critical hits find it more often."

#. data/attack.json › mods › eclat › name
#. data/branches/aube.json › aube › notable › names
msgid "Éclat"
msgstr "Burst"

#. data/attack.json › mods › eclat › text
msgid "Un ennemi tué par l'attaque éclate en épines ({p} % des dégâts)."
msgstr "An enemy killed by the attack bursts into thorns ({p}% of damage)."

#. data/attack.json › mods › elan › name
#. data/branches/vent.json › vent › clusters › course › nodes › r7 › name
msgid "Élan"
msgstr "Momentum"

#. data/attack.json › mods › elan › text
msgid "En mouvement, l'attaque fait {p} % de dégâts en plus."
msgstr "While moving, the attack deals {p}% more damage."

#. data/attack.json › mods › enracine › name
msgid "Enracinement"
msgstr "Rooting"

#. data/attack.json › mods › enracine › text
msgid "{p} % de chances d'enraciner l'ennemi touché."
msgstr "{p}% chance to root the enemy hit."

#. data/attack.json › mods › fourche › name
msgid "Fourche"
msgstr "Fork"

#. data/attack.json › mods › fourche › text
#. {0}, {1}… : nombres du texte d'origine, remis au format de la langue.
msgid "Au premier coup, l'attaque se divise : +{v} branche(s) ({0} % des dégâts ; éclats pour un coup au corps à corps ou une spore, rayons obliques pour un rayon)."
msgstr "On the first hit, the attack splits: +{v} branch(es) ({0}% of damage; shards for a melee blow or a spore, slanting rays for a ray)."

#. data/attack.json › mods › incandescence › name
#. data/branches/aube.json › aube › originals › names
msgid "Incandescence"
msgstr "Incandescence"

#. data/attack.json › mods › incandescence › text
msgid "Les coups critiques de l'attaque font {p} % de dégâts en plus."
msgstr "The attack's critical hits deal {p}% more damage."

#. data/attack.json › mods › poison › name
msgid "Poison"
msgstr "Poison"

#. data/attack.json › mods › poison › text
msgid "Chaque coup empoisonne ({p} % des dégâts par seconde)."
msgstr "Each hit poisons ({p}% of damage per second)."

#. data/attack.json › mods › portee › name
msgid "Portée"
msgstr "Range"

#. data/attack.json › mods › portee › text
msgid "Portée de l'attaque : +{p} %."
msgstr "Attack range: +{p}%."

#. data/attack.json › mods › refraction › name
#. data/branches/aube.json › aube › clusters › rayon › nodes › l5 › name
msgid "Réfraction"
msgstr "Refraction"

#. data/attack.json › mods › refraction › text
#. {0}, {1}… : nombres du texte d'origine, remis au format de la langue.
msgid "Au premier ennemi touché, l'attaque se brise en {v} rayon(s) obliques ({0} % des dégâts)."
msgstr "On the first enemy hit, the attack breaks into {v} slanting ray(s) ({0}% of damage)."

#. data/attack.json › mods › renforcee › name
msgid "Attaque renforcée"
msgstr "Empowered Attack"

#. data/attack.json › mods › renforcee › text
msgid "Une attaque sur {n} est renforcée (dégâts ×{f}, plus grande)."
msgstr "One attack in {n} is empowered (damage ×{f}, larger)."

#. data/attack.json › mods › repetition › name
msgid "Répétition"
msgstr "Repeat"

#. data/attack.json › mods › repetition › text
msgid "L'attaque frappe {v} fois de plus."
msgstr "The attack strikes {v} more time(s)."

#. data/attack.json › mods › repousse › name
msgid "Repousse"
msgstr "Knockback"

#. data/attack.json › mods › repousse › text
msgid "Chaque coup repousse l'ennemi de {v} pixels."
msgstr "Each hit pushes the enemy back {v} pixels."

#. data/attack.json › mods › ricochet › name
msgid "Ricochet"
msgstr "Ricochet"

#. data/attack.json › mods › ricochet › text
msgid "L'attaque rebondit vers un autre ennemi : +{v} rebond(s)."
msgstr "The attack bounces to another enemy: +{v} bounce(s)."

#. data/attack.json › mods › rosee › name
#. data/branches/seve.json › seve › clusters › lianes › nodes › n6 › name
#. data/branches/seve.json › seve › clusters › rosee › nodes › r1 › name
#. data/branches/seve.json › seve › notable › names
